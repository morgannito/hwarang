/target
**/*.rs.bk
.DS_Store

# Client Godot (a venir)
.godot/
/client/android/
export_presets.cfg

# Secrets d'environnement : jamais versionnes
.env
*.local.toml

# Base locale du serveur
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Caches Python des scripts de demonstration
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Assets locaux : JAMAIS versionnes.
#
# Le depot est public et sous licence AGPL. Y committer des fichiers dont on
# n'a pas les droits, c'est de la redistribution — et l'historique git les
# conserve meme apres suppression, ce qui obligerait a le reecrire en entier.
#
# Poser ses assets dans client/assets/ : le client les charge s'ils sont la,
# et retombe sur des formes geometriques sinon.
# ---------------------------------------------------------------------------
client/assets/*
!client/assets/README.md
!client/assets/.gitkeep
